# Aurora Massages — environment variables
# Copy to .env (NOT committed) for local dev, or set via `vercel env add` for production.
#
# All notifiers are optional. If none are set, the booking endpoint returns 202
# and the frontend falls back to the customer-driven WhatsApp deep link, which
# always works (no API key needed).

# ---- Email (Resend) ----------------------------------------------------
# Sign up at https://resend.com — free tier covers small shops.
# Verify a sender domain or use their test sender for staging.
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=balie@auroramassages.nl
NOTIFY_EMAIL_TO=balie@auroramassages.nl

# ---- Telegram (optional, easiest push notification) -------------------
# Talk to @BotFather to create a bot, then send any message to your bot
# and call https://api.telegram.org/bot<TOKEN>/getUpdates to find the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
